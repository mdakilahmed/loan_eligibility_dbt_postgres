riginal_path as full_path\n                from \"loan_database\".\"transformed_elementary\".\"dbt_models\"\n                \n                  where package_name != 'elementary'\n                \n              )\n\n             select * from dbt_artifacts_models\n        \n  ", "name": "SQLQuery", "pid": 5680, "thread": "MainThread", "ts": "2024-10-30T06:52:55.875789Z"}}
