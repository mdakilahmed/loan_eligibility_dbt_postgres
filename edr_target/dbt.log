{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"name\": \"loan_eligibility\", \"unique_id\": \"model.dbt_loan_project.loan_eligibility\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"loan_eligibility\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"This model is used to assess and determine the loan eligibility of applicants based on various financial and credit risk factors. The model outputs a decision regarding the loan application, including whether it's approved, requires manual review, or is declined.\", \"materialization\": \"table\", \"patch_path\": \"dbt_loan_project://models\\\\mart\\\\schema.yml\", \"full_path\": \"models\\\\mart\\\\loan_eligibility.sql\"}, {\"name\": \"stg_employment_information\", \"unique_id\": \"model.dbt_loan_project.stg_employment_information\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"stg_employment_information\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Staging table for storing applicant employment details, including job title, employer, and employment status.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\staging\\\\schema.yml\", \"full_path\": \"models\\\\staging\\\\stg_employment_information.sql\"}, {\"name\": \"stg_financial_information\", \"unique_id\": \"model.dbt_loan_project.stg_financial_information\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"stg_financial_information\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Staging table for storing financial information of the applicant, including income, expenses, and debts.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\staging\\\\schema.yml\", \"full_path\": \"models\\\\staging\\\\stg_financial_information.sql\"}, {\"name\": \"stg_loan_application\", \"unique_id\": \"model.dbt_loan_project.stg_loan_application\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"stg_loan_application\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Staging table for loan applications with deduplicated records. It contains information about loan application submissions and requested amounts.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\staging\\\\schema.yml\", \"full_path\": \"models\\\\staging\\\\stg_loan_application.sql\"}, {\"name\": \"stg_contact_information\", \"unique_id\": \"model.dbt_loan_project.stg_contact_information\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"stg_contact_information\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Staging table for storing applicant contact details, including address, phone number, and email.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\staging\\\\schema.yml\", \"full_path\": \"models\\\\staging\\\\stg_contact_information.sql\"}, {\"name\": \"stg_applicants\", \"unique_id\": \"model.dbt_loan_project.stg_applicants\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"stg_applicants\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Staging table for applicant information, including personal details such as name, date of birth, and gender. This table serves as a base for linking applicant-related information across the loan eligibility pipeline.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\staging\\\\schema.yml\", \"full_path\": \"models\\\\staging\\\\stg_applicants.sql\"}, {\"name\": \"trs_risk_assessment\", \"unique_id\": \"model.dbt_loan_project.trs_risk_assessment\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"trs_risk_assessment\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Transformed model that assesses and assigns risk tiers to applicants based on various credit, financial, and employment factors. The risk tier determines the likelihood of loan repayment.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\transformation\\\\schema.yml\", \"full_path\": \"models\\\\transformation\\\\trs_risk_assessment.sql\"}, {\"name\": \"trs_applicant_details\", \"unique_id\": \"model.dbt_loan_project.trs_applicant_details\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"trs_applicant_details\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Dimension table that consolidates key applicant details, including their age, derived from the date of birth. This table serves as the primary source of applicant identity and demographic information for downstream models.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\transformation\\\\schema.yml\", \"full_path\": \"models\\\\transformation\\\\trs_applicant_details.sql\"}, {\"name\": \"trs_employment_analysis\", \"unique_id\": \"model.dbt_loan_project.trs_employment_analysis\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"trs_employment_analysis\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"This model consolidates and analyzes employment information for applicants, with an emphasis on calculating employment stability. The analysis helps assess the applicant's job stability.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\transformation\\\\schema.yml\", \"full_path\": \"models\\\\transformation\\\\trs_employment_analysis.sql\"}, {\"name\": \"trs_credit_analysis\", \"unique_id\": \"model.dbt_loan_project.trs_credit_analysis\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"trs_credit_analysis\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Dimension table that consolidates credit-related information for each applicant, including their credit score and the credit utilization ratio. This table is used to assess an applicant's creditworthiness.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\transformation\\\\schema.yml\", \"full_path\": \"models\\\\transformation\\\\trs_credit_analysis.sql\"}, {\"name\": \"trs_residence_stability\", \"unique_id\": \"model.dbt_loan_project.trs_residence_stability\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"trs_residence_stability\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Transformed model that analyzes the applicant's residence stability, indicating whether they have resided at their current address for at least one year.\", \"materialization\": \"view\", \"patch_path\": \"dbt_loan_project://models\\\\transformation\\\\schema.yml\", \"full_path\": \"models\\\\transformation\\\\trs_residence_stability.sql\"}, {\"name\": \"trs_financial_metrics\", \"unique_id\": \"model.dbt_loan_project.trs_financial_metrics\", \"database_name\": \"loan_database\", \"schema_name\": \"transformed\", \"table_name\": \"trs_financial_metrics\", \"owners\": \"[]\", \"tags\": \"[]\", \"package_name\": \"dbt_loan_project\", \"description\": \"Transformed model that analyzes the applicant's financial situation, focusing on key ratios such as the Debt-to-Income (DTI) and Loan-to-Income (LTI) ratios, which provide insight into the applicant's financial health and ability to repay loans.\", \"materialization\": \"view\", \"patch_p